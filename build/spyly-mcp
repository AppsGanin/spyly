#!/bin/sh
# Запускалка MCP-сервера Spyly.
#
# Electron умеет работать как обычный Node, поэтому отдельный Node в системе
# не нужен: агент получает рабочий сервер сразу после установки приложения.
here=$(cd "$(dirname "$0")" && pwd)
app=$(cd "$here/../.." && pwd)
exec env ELECTRON_RUN_AS_NODE=1 "$app/MacOS/Spyly" "$here/../mcp-server/bundle.mjs" "$@"
