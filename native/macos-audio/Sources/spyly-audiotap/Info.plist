<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  These descriptions are embedded into the binary itself.

  The helper is not an application but a standalone executable, and without an
  Info.plist of its own the system shows no access request for it: EventKit
  simply answers with a refusal, without asking the person. The texts have to be
  here, not only in the application's Info.plist.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>dev.spyly.audiotap</string>
  <key>CFBundleName</key>
  <string>Spyly</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Spyly подставит в запись название встречи и список участников из календаря.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Spyly подставит в запись название встречи и список участников из календаря.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Spyly записывает ваш голос, чтобы расшифровать разговор.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Spyly записывает звук приложений, чтобы расшифровать собеседников.</string>
</dict>
</plist>
